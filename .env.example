# =============================================================================
# SourceFolio - Production environment variables
# =============================================================================
# Copy this file to .env next to docker-compose.prod.yml on the server.
# NEVER commit the .env file
#
# Every variable here is required unless marked optional: application-prod.yml
# gives none of them a default, so the backend refuses to start rather than run
# on a development value.
# =============================================================================

# ── Release ───────────────────────────────────────────────────────────────────
# Optional. Version of the backend and frontend images (a vX.Y.Z tag). The deploy
# workflow writes it after each deployment; leave it unset on a fresh server.
# IMAGE_TAG=v0.1.0

# ── Domain ────────────────────────────────────────────────────────────────────
# One domain serves everything: Traefik sends /api, /oauth2 and /login/oauth2 to
# the backend and the rest to Next.js. The name is provisional.
APP_DOMAIN=sourcefolio.dev
# Canonical origin written into metadata, hreflang, the sitemap and emails.
SITE_URL=https://sourcefolio.dev

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=sourcefolio-postgres
DB_PORT=5432
DB_NAME=sourcefolio
DB_USERNAME=sourcefolio
DB_PASSWORD=CHANGE_ME_strong_password

# ── GitHub ────────────────────────────────────────────────────────────────────
# OAuth App used for sign-in. Callback URL: https://<APP_DOMAIN>/login/oauth2/code/github
# The only scope requested is read:user.
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
# Token for the background sync of public repositories (higher rate limit than
# anonymous calls). A fine-grained token with no repository access is enough.
GITHUB_API_TOKEN=CHANGE_ME

# ── Object storage (Cloudflare R2) ────────────────────────────────────────────
# Screenshots and their variants. Any S3-compatible provider works.
S3_ENDPOINT=https://CHANGE_ME_account_id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=sourcefolio
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Public origin the images are served from (R2 custom domain).
S3_PUBLIC_URL=https://media.sourcefolio.dev

# ── SMTP / Mail ───────────────────────────────────────────────────────────────
# Health alerts, removal notices, weekly digest. Sent in the recipient's language.
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD="CHANGE_ME"
MAIL_FROM=SourceFolio <hello@sourcefolio.dev>
MAIL_AUTH=true
MAIL_STARTTLS=true

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_password
# Internal actuator port scraped by Prometheus (never routed publicly)
MANAGEMENT_PORT=9090

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
